{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Sweeper",
  "version": "0.1.0",
  "identifier": "app.music-sweeper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Music Sweeper",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Music",
    "resources": { "../analysis/": "analysis/", "../scripts/setup-analysis.ps1": "scripts/setup-analysis.ps1", "../scripts/setup-chordmini.ps1": "scripts/setup-chordmini.ps1", "../scripts/runtime-lock.ps1": "scripts/runtime-lock.ps1" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ]
      }
    }
  }
}
