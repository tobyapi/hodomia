{
  "name": "music-sweeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "headless": "node scripts/headless.mjs",
    "mcp": "node automation/mcp-server.mjs",
    "mcp:config": "node scripts/mcp-config.mjs",
    "test:automation": "node --test automation/tests/*.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo test --locked --manifest-path src-tauri/Cargo.toml && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run test && npm run test:analysis && npm run test:automation && npm run build && npm run check:rust",
    "test:analysis": "node scripts/test-analysis.mjs",
    "setup:analysis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-analysis.ps1",
    "setup:chordmini": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-chordmini.ps1",
    "setup:yamnet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-yamnet.ps1",
    "harness:prepare": "node scripts/prepare-ui-harness.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
